<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FairLens | Human-Centered AI Bias Detection</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #fbf7ff;
      --bg-strong: #f1ebfb;
      --panel: rgba(255, 255, 255, 0.82);
      --panel-solid: #ffffff;
      --line: rgba(118, 103, 145, 0.12);
      --text: #2d2640;
      --muted: #7b7391;
      --accent: #eea8b8;
      --accent-deep: #cd7f92;
      --accent-soft: #ffd9e2;
      --secondary: #7fc7c1;
      --secondary-soft: #e2f4f1;
      --success: #8cc7a4;
      --warning: #e7c98e;
      --danger: #e6a0a7;
      --shadow: 0 22px 48px rgba(119, 109, 155, 0.10);
      --shadow-soft: 0 10px 24px rgba(119, 109, 155, 0.08);
      --radius-xl: 30px;
      --radius-lg: 22px;
      --radius-md: 16px;
      --radius-sm: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: "Outfit", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(238, 168, 184, 0.24), transparent 24%),
        radial-gradient(circle at 86% 8%, rgba(127, 199, 193, 0.22), transparent 22%),
        radial-gradient(circle at 50% 100%, rgba(228, 213, 255, 0.28), transparent 28%),
        linear-gradient(180deg, #fff9fd 0%, #f8f6ff 46%, #f9fffd 100%);
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(152, 136, 181, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(152, 136, 181, 0.035) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      opacity: 0.5;
      z-index: 0;
    }

    .app-shell {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 30px 20px 24px;
      border-right: 1px solid rgba(152, 136, 181, 0.10);
      background: linear-gradient(180deg, rgba(255, 250, 255, 0.84), rgba(245, 249, 255, 0.78));
      backdrop-filter: blur(24px);
      display: flex;
      flex-direction: column;
      gap: 18px;
      overflow: hidden;
    }

    .brand {
      padding: 22px;
      border: 1px solid rgba(205, 127, 146, 0.14);
      background: radial-gradient(circle at top right, rgba(238, 168, 184, 0.18), transparent 34%), linear-gradient(145deg, rgba(255, 253, 255, 0.98), rgba(244, 245, 255, 0.95));
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .brand-mark {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--accent), #f5a56d);
      color: white;
      font-size: 22px;
      margin-bottom: 14px;
      box-shadow: 0 14px 30px rgba(216, 111, 69, 0.24);
    }

    .brand h1 {
      font-size: 1.55rem;
      line-height: 1;
      margin-bottom: 8px;
    }

    .brand p {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .nav-title,
    .mini-title {
      font-family: "IBM Plex Mono", monospace;
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      color: #8a7768;
      margin: 4px 6px;
    }

    .nav-list {
      display: grid;
      gap: 8px;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding-right: 6px;
      align-content: start;
    }

    .nav-list::-webkit-scrollbar {
      width: 6px;
    }

    .nav-list::-webkit-scrollbar-thumb {
      background: rgba(159, 73, 45, 0.25);
      border-radius: 999px;
    }

    .nav-list::-webkit-scrollbar-track {
      background: transparent;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 13px 14px;
      border: 1px solid transparent;
      border-radius: 16px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: 0.22s ease;
    }

    .nav-item:hover,
    .nav-item.active {
      background: rgba(255, 252, 248, 0.98);
      border-color: rgba(205, 127, 146, 0.16);
      box-shadow: 0 10px 22px rgba(119, 109, 155, 0.08);
      transform: translateY(-2px);
    }

    .nav-step {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: rgba(216, 111, 69, 0.12);
      color: var(--accent-deep);
      font-weight: 700;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .nav-copy {
      flex: 1;
    }

    .nav-copy strong {
      display: block;
      font-size: 0.96rem;
      margin-bottom: 2px;
    }

    .nav-copy span {
      display: block;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .step-badge {
      min-width: 58px;
      padding: 6px 9px;
      border-radius: 999px;
      text-align: center;
      font-size: 0.74rem;
      font-weight: 700;
      background: rgba(107, 98, 90, 0.1);
      color: var(--muted);
    }

    .step-badge.active {
      background: rgba(216, 111, 69, 0.14);
      color: var(--accent-deep);
    }

    .step-badge.done {
      background: rgba(47, 143, 98, 0.14);
      color: var(--success);
    }

    .pipeline-card {
      margin-top: auto;
      padding: 18px;
      border-radius: var(--radius-lg);
      background: linear-gradient(160deg, rgba(255, 251, 245, 0.95), rgba(242, 233, 219, 0.96));
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .pipeline-card p {
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-top: 8px;
      margin-bottom: 14px;
    }

    .pipeline-bar {
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: rgba(107, 98, 90, 0.12);
      overflow: hidden;
      margin-bottom: 10px;
    }

    .pipeline-fill {
      width: 12.5%;
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--secondary));
      border-radius: inherit;
      transition: width 0.35s ease;
    }

    .pipeline-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.8rem;
      color: #7c6a5d;
    }

    .main {
      padding: 34px 34px 44px;
      max-width: 1460px;
      width: 100%;
      margin: 0 auto;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 24px;
      margin-bottom: 22px;
    }

    .hero-card,
    .hero-side,
    .panel,
    .metric-card,
    .chart-card,
    .insight-card,
    .table-wrap,
    .log-card {
      border-radius: var(--radius-xl);
      background: var(--panel);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(152, 136, 181, 0.12);
      box-shadow: var(--shadow);
    }

    .hero-card {
      padding: 34px;
      background:
        radial-gradient(circle at 88% 12%, rgba(238, 168, 184, 0.20), transparent 26%),
        radial-gradient(circle at 12% 88%, rgba(127, 199, 193, 0.18), transparent 20%),
        linear-gradient(145deg, rgba(255, 253, 255, 0.99), rgba(248, 245, 255, 0.96));
      position: relative;
      overflow: hidden;
    }

    .hero-card::after {
      content: "";
      position: absolute;
      right: -80px;
      top: -80px;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(228, 213, 255, 0.44), transparent 62%);
      pointer-events: none;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(216, 111, 69, 0.12);
      color: var(--accent-deep);
      font-weight: 700;
      margin-bottom: 20px;
      font-size: 0.84rem;
      box-shadow: inset 0 0 0 1px rgba(205, 127, 146, 0.08);
    }

    .hero-card h2 {
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      line-height: 0.98;
      margin-bottom: 14px;
      max-width: 11ch;
      letter-spacing: -0.04em;
      position: relative;
      z-index: 1;
    }

    .hero-card p {
      color: var(--muted);
      line-height: 1.8;
      font-size: 1.03rem;
      max-width: 56ch;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      position: relative;
      z-index: 1;
    }

    .hero-summary {
      color: var(--muted);
      line-height: 1.8;
      font-size: 1.03rem;
      max-width: 56ch;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .hero-highlights {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
      position: relative;
      z-index: 1;
    }

    .hero-tag {
      padding: 9px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(107, 98, 90, 0.1);
      color: var(--text);
      font-size: 0.86rem;
      font-weight: 600;
      box-shadow: var(--shadow-soft);
    }

    .button,
    .secondary-button,
    .ghost-button {
      border: none;
      cursor: pointer;
      font: inherit;
      transition: 0.22s ease;
    }

    .button {
      padding: 15px 20px;
      border-radius: 18px;
      background: linear-gradient(135deg, #efb8c6, #e4c7ff);
      color: #523f68;
      font-weight: 700;
      box-shadow: 0 14px 28px rgba(205, 127, 146, 0.18);
    }

    .button:hover {
      transform: translateY(-1px);
      box-shadow: 0 18px 34px rgba(216, 111, 69, 0.28);
    }

    .secondary-button {
      padding: 15px 20px;
      border-radius: 18px;
      background: rgba(127, 199, 193, 0.18);
      color: var(--secondary);
      font-weight: 700;
      border: 1px solid rgba(127, 199, 193, 0.16);
    }

    .secondary-button:hover,
    .ghost-button:hover {
      transform: translateY(-1px);
    }

    .ghost-button {
      padding: 15px 20px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.74);
      color: var(--text);
      font-weight: 700;
      border: 1px solid rgba(107, 98, 90, 0.14);
    }

    .hero-side {
      padding: 28px;
      display: grid;
      gap: 18px;
      align-content: start;
      background:
        radial-gradient(circle at top right, rgba(127, 199, 193, 0.18), transparent 34%),
        linear-gradient(160deg, rgba(255, 253, 255, 0.97), rgba(246, 247, 255, 0.98));
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.86rem;
      width: fit-content;
    }

    .status-pill::before {
      content: "";
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: currentColor;
    }

    .status-pill.idle {
      background: rgba(107, 98, 90, 0.12);
      color: #72675d;
    }

    .status-pill.running {
      background: rgba(179, 112, 22, 0.16);
      color: var(--warning);
    }

    .status-pill.complete {
      background: rgba(47, 143, 98, 0.16);
      color: var(--success);
    }

    .hero-side h3 {
      font-size: 1.18rem;
      margin-bottom: 4px;
    }

    .hero-side p {
      color: var(--muted);
      line-height: 1.7;
    }

    .hero-metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .metric-chip {
      padding: 16px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(152, 136, 181, 0.08);
      box-shadow: var(--shadow-soft);
    }

    .metric-chip span {
      display: block;
      color: var(--muted);
      font-size: 0.82rem;
      margin-bottom: 5px;
    }

    .metric-chip strong {
      font-size: 1.18rem;
    }

    .crumbs {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
      padding: 0 8px;
    }

    .crumbs p {
      color: var(--muted);
      font-size: 0.94rem;
    }

    .feature-ribbon,
    .scenario-strip,
    .usecase-grid,
    .copilot-grid,
    .playground-grid,
    .score-grid,
    .report-actions {
      display: grid;
      gap: 18px;
    }

    .feature-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0 0 16px;
    }

    .feature-ribbon .score-card {
      grid-column: 1 / -1;
    }

    .scenario-strip,
    .usecase-grid,
    .playground-grid,
    .copilot-grid,
    .score-grid,
    .report-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .usecase-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 12px;
    }

    .usecase-card {
      padding: 20px;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(107, 98, 90, 0.1);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: 0.22s ease;
    }

    .usecase-card:hover,
    .usecase-card.active {
      transform: translateY(-2px);
      border-color: rgba(207, 111, 73, 0.22);
      background: rgba(255, 247, 239, 0.98);
      box-shadow: 0 18px 34px rgba(84, 53, 26, 0.1);
    }

    .usecase-card h5 {
      font-size: 1rem;
      margin-bottom: 8px;
    }

    .usecase-card p {
      color: var(--muted);
      line-height: 1.6;
      font-size: 0.9rem;
      margin-bottom: 12px;
    }

    .usecase-tag {
      display: inline-flex;
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(39, 89, 85, 0.08);
      color: var(--secondary);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .feature-card,
    .copilot-card,
    .score-card,
    .forecast-card,
    .playground-card,
    .story-card,
    .endpoint-card,
    .alert-card {
      border-radius: var(--radius-xl);
      background: var(--panel);
      border: 1px solid rgba(152, 136, 181, 0.10);
      box-shadow: var(--shadow);
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before,
    .copilot-card::before,
    .score-card::before,
    .forecast-card::before,
    .playground-card::before,
    .story-card::before,
    .endpoint-card::before,
    .alert-card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 1px;
      background: linear-gradient(90deg, rgba(238, 168, 184, 0), rgba(238, 168, 184, 0.24), rgba(127, 199, 193, 0));
      pointer-events: none;
    }

    .feature-card h4,
    .copilot-card h4,
    .score-card h4,
    .forecast-card h4,
    .playground-card h4,
    .story-card h4,
    .endpoint-card h4,
    .alert-card h4 {
      font-size: 1.12rem;
      margin-bottom: 8px;
    }

    .feature-card p,
    .copilot-card p,
    .score-card p,
    .forecast-card p,
    .playground-card p,
    .story-card p,
    .endpoint-card p,
    .alert-card p {
      color: var(--muted);
      line-height: 1.65;
    }

    .scenario-buttons,
    .endpoint-list,
    .alert-list,
    .score-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }

    .chip-button,
    .endpoint-pill {
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(107, 98, 90, 0.16);
      background: rgba(255, 255, 255, 0.66);
      color: var(--text);
      font: inherit;
      cursor: pointer;
      transition: 0.22s ease;
    }

    .chip-button.active,
    .chip-button:hover,
    .endpoint-pill:hover {
      border-color: rgba(205, 127, 146, 0.22);
      background: rgba(255, 245, 250, 0.95);
      transform: translateY(-1px);
    }

    .forecast-meter {
      margin-top: 18px;
      padding: 16px;
      border-radius: 18px;
      background: rgba(250, 244, 255, 0.9);
      border: 1px solid rgba(152, 136, 181, 0.1);
    }

    .forecast-head,
    .mini-row,
    .score-row,
    .alert-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .forecast-risk {
      font-size: 2rem;
      font-weight: 800;
      margin: 10px 0 4px;
    }

    .forecast-label,
    .score-label,
    .alert-meta,
    .small-note {
      color: var(--muted);
      font-size: 0.88rem;
    }

    .score-list {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }

    .score-row {
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(152, 136, 181, 0.08);
    }

    .score-pill {
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .score-pill.good {
      background: rgba(47, 143, 98, 0.14);
      color: var(--success);
    }

    .score-pill.medium {
      background: rgba(179, 112, 22, 0.14);
      color: var(--warning);
    }

    .score-pill.high {
      background: rgba(199, 72, 66, 0.14);
      color: var(--danger);
    }

    .copilot-answer,
    .story-output,
    .proxy-output,
    .generator-output {
      margin-top: 16px;
      padding: 16px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(152, 136, 181, 0.08);
      line-height: 1.7;
    }

    .copilot-answer strong,
    .story-output strong,
    .proxy-output strong,
    .generator-output strong {
      display: inline-block;
      margin-right: 8px;
    }

    .playground-controls {
      display: grid;
      gap: 14px;
      margin-top: 16px;
    }

    .playground-result {
      margin-top: 16px;
      padding: 18px;
      border-radius: 20px;
      background: linear-gradient(145deg, rgba(255, 244, 248, 0.98), rgba(243, 250, 249, 0.96));
      border: 1px solid rgba(152, 136, 181, 0.08);
    }

    .playground-score {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .tradeoff-chart {
      margin-top: 18px;
      min-height: 240px;
      padding: 18px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(152, 136, 181, 0.08);
      position: relative;
      overflow: hidden;
    }

    .tradeoff-grid {
      position: absolute;
      inset: 18px;
      background-image:
        linear-gradient(rgba(107, 98, 90, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(107, 98, 90, 0.08) 1px, transparent 1px);
      background-size: 48px 48px;
      border-radius: 16px;
    }

    .tradeoff-dot {
      position: absolute;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent);
      border: 2px solid rgba(255,255,255,0.85);
      box-shadow: 0 10px 20px rgba(216, 111, 69, 0.2);
    }

    .tradeoff-dot.active {
      width: 18px;
      height: 18px;
      background: var(--secondary);
      box-shadow: 0 14px 26px rgba(41, 92, 88, 0.28);
    }

    .tradeoff-legend {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 18px;
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .alert-list {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }

    .alert-row {
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.62);
      border: 1px solid rgba(107, 98, 90, 0.1);
    }

    .alert-tone {
      padding: 6px 9px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .alert-tone.ok {
      backgro
